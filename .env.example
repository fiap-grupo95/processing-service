# processing-service — variáveis de ambiente
# Copie para .env e preencha os valores obrigatórios

# DynamoDB Local (credenciais fake aceitas pelo DynamoDB Local)
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=processing_jobs
AWS_ACCESS_KEY_ID=fakekey
AWS_SECRET_ACCESS_KEY=fakesecret

# MinIO (console disponível em localhost:9021)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=diagrams

# RabbitMQ (painel disponível em localhost:15673)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=

# Filas e tópicos
PROCESS_QUEUE=process.queue
REPORT_QUEUE=report.queue
PROCESSING_TOPIC=processing.topic

# LLM — obrigatório
LLM_API_KEY=your-llm-api-key
LLM_MODEL=o4-mini
LLM_MAX_TOKENS=4096
LLM_PROVIDER=openai
